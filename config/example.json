{
  "program": {
    "name": "example-program",
    "platform": "hackerone",
    "authorized": false
  },
  "scope": {
    "include": [
      "*.example.com",
      "api.example.com"
    ],
    "exclude": [
      "*.staging.example.com",
      "blog.example.com"
    ]
  },
  "limits": {
    "global_rps": 10.0,
    "per_host_rps": 5.0,
    "concurrency": 20,
    "timeout": 10.0,
    "max_retries": 2
  },
  "http": {
    "user_agent": "baugbaunty/0.1 (authorized-security-testing; you@example.com)",
    "verify_tls": true,
    "follow_redirects": true,
    "extra_headers": {},
    "proxy": ""
  },
  "auth": {
    "bearer": "",
    "cookie": "",
    "headers": {}
  },
  "modules": {
    "subdomains": { "sources": ["crtsh"], "use_external": true },
    "dns": {
      "use_external": true,
      "detect_wildcard": true,
      "filter_wildcard": true,
      "wildcard_test_count": 3
    },
    "takeover": { "extra": "" },
    "wayback": { "sources": ["wayback", "otx"], "max_urls": 5000 },
    "jsintel": { "max_files": 200, "scan_secrets": true },
    "seeds": { "favicon": true },
    "vhost": { "wordlist": "", "max_hosts": 300 },
    "params": { "wordlist": "", "chunk_size": 25, "max_params": 500 },
    "webchecks": {
      "checks": ["cors", "openredirect", "reflection", "crlf", "hostheader", "ssrf"],
      "max_targets": 300,
      "ssrf_canary": ""
    },
    "cvecheck": { "extra": "", "online": false },
    "githubdork": { "token": "", "terms": [], "max_results": 20 },
    "ratecal": { "max_requests": 15, "concurrency": 10 },
    "openapi": {},
    "buckets": { "keywords": [], "providers": ["s3", "gcs", "azure"], "max_candidates": 200 },
    "screenshot": {},
    "content": {
      "wordlist": "",
      "extensions": ["", "/"],
      "permute_ext": [],
      "recurse": false,
      "max_depth": 1,
      "status_allow": [200, 204, 301, 302, 307, 401, 403, 405]
    },
    "ports": { "top_ports": 100, "use_external": true },
    "nuclei": {
      "severity": ["low", "medium", "high", "critical"],
      "rate_limit": 150,
      "templates": "",
      "tags": [],
      "exclude_severity": [],
      "update": false,
      "extra_args": []
    }
  },
  "notifications": {
    "enabled": false,
    "slack_webhook": "",
    "discord_webhook": "",
    "telegram_bot_token": "",
    "telegram_chat_id": "",
    "generic_webhook": "",
    "min_severity": "medium"
  },
  "output": {
    "dir": "output",
    "formats": ["json", "markdown", "html", "pdf"]
  }
}
